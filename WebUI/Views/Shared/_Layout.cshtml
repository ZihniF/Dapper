@{
    var records = ViewContext.RouteData.Values["controller"]?.ToString() == "Records";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · EnergyPulse</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <a href="/" class="brand">
            <span class="brand-icon">ϟ</span>
            <span>
                energy<span class="brand-light">pulse</span>
                <small>ŞEHİR TÜKETİM ANALİZİ</small>
            </span>
        </a>

        <div class="nav-label">ÇALIŞMA ALANI</div>
        <nav>
            <a href="/" class="@(!records ? "active" : "")">
                <span>▦</span>
                Genel bakış
            </a>
            <a href="/Records" class="@(records ? "active" : "")">
                <span>☷</span>
                Tüketim kayıtları
            </a>
        </nav>

        <div class="sidebar-bottom">
            <span class="live-dot"></span>
            Türkiye / Enerji izleme
            <p>20 şehir · 100 ilçe</p>
            <div class="dataset-note">
                AI ile üretilmiş<br />
                sentetik veri seti
            </div>
        </div>
    </aside>

    <div class="workspace">
        <header class="topbar">
            <span>
                Çalışma alanı
                <b>/</b>
                @ViewData["Title"]
            </span>
            <div class="topbar-right">
                <span class="environment">YEREL ANALİZ</span>
                <span class="avatar">EP</span>
            </div>
        </header>

        <main>
            @RenderBody()
        </main>

        <footer>
            EnergyPulse
            <span>Veriye dayalı enerji görünümü.</span>
            <span>Sentetik veri · 2016–2025</span>
        </footer>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

